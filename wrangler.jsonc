{
	"name": "ttml-tool",
	"compatibility_date": "2026-10-24",
	// Static assets only, no Worker script. public/_headers sets COOP/COEP.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	// Workers Builds preview builds (non-production branches) fail without this.
	"previews": {}
}
